{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm --filter=loseta test && pnpm --filter=loseta check && pnpm --filter=web check",
    "docs:css": "node packages/loseta/scripts/generate-docs-css.mjs",
    "web:dev": "pnpm docs:css && pnpm --filter=web dev",
    "web:build": "pnpm docs:css && pnpm --filter=web build",
    "cli:build": "pnpm --filter=loseta build",
    "cli:smoke": "pnpm --filter=loseta smoke",
    "registry:check": "pnpm --filter=loseta validate",
    "registry:examples": "pnpm --filter=loseta examples",
    "gate": "node scripts/gate.mjs",
    "gate:test": "node scripts/gate.mjs pnpm test",
    "gate:registry": "node scripts/gate.mjs pnpm registry:check",
    "gate:e2e": "node scripts/gate.mjs pnpm --filter web test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0"
}

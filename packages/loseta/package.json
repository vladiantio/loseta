{
  "name": "loseta",
  "version": "0.22.1",
  "description": "Native CSS component scaffolds with the shadcn feel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladiantio/loseta.git",
    "directory": "packages/loseta"
  },
  "homepage": "https://github.com/vladiantio/loseta",
  "bugs": {
    "url": "https://github.com/vladiantio/loseta/issues"
  },
  "keywords": [
    "css",
    "components",
    "shadcn",
    "scaffold",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "loseta": "./bin/loseta.js"
  },
  "files": [
    "bin",
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "deps:check": "node scripts/check-dependencies.mjs",
    "deps:report": "node scripts/check-dependencies.mjs --report",
    "smoke": "bash scripts/smoke-init.sh",
    "validate": "node scripts/validate-registry.mjs",
    "examples": "tsx scripts/generate-examples.ts",
    "check": "pnpm build && pnpm validate && pnpm deps:check && pnpm behaviors:check",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm validate",
    "behaviors:check": "tsc -p tsconfig.behaviors.json"
  },
  "dependencies": {
    "@jetio/validator": "^3.1.0",
    "@topcli/prompts": "^4.0.0",
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "lightningcss": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import { components, type ComponentDoc } from "@/data/components";

export function getStaticPaths() {
  return components.map((component) => ({
    params: { id: component.id },
    props: { component }
  }));
}

interface Props {
  component: ComponentDoc;
}

const { component } = Astro.props;
const isExperimental = component.status === "experimental";
const defaultExample = component.examples.find(
  (example) => example.title === "Default"
);
const examples = component.examples.filter(
  (example) => example !== defaultExample
);
---

<Layout
  title={component.title}
  description={component.description}
  experimental={isExperimental}
>
  <div class="docs-content">
    <p class="docs-eyebrow">Components / {component.group}</p>
    <h1>{component.title}</h1>
    <p class="docs-lead">{component.description}</p>

    <div class="docs-meta">
      <span class="docs-chip"><strong>Status</strong> {component.status}</span>
      {
        component.deps.length > 0 && (
          <span class="docs-chip"><strong>Installs</strong> {component.deps.join(", ")}</span>
        )
      }
      {
        component.optional.length > 0 && (
          <span class="docs-chip">
            <strong>Works with</strong> {component.optional.join(", ")}
          </span>
        )
      }
    </div>

    {
      isExperimental && (
        <div class="docs-callout" role="note">
          <strong>Experimental.</strong> This component is outside the v1
          compatibility contract, ships only the Nova style and may change
          without notice.
        </div>
      )
    }

    {
      defaultExample && (
        <ComponentPreview
          id={`${component.id}-example-default`}
          html={defaultExample.html}
        />
      )
    }

    <h2>Installation</h2>
    <InstallCommand
      command={`loseta add ${component.id}${isExperimental ? " --experimental" : ""}`}
    />

    {
      examples.length > 0 && (
        <>
          <h2>Examples</h2>
          {examples.map((example, index) => (
            <ComponentPreview
              id={`${component.id}-example-${index + 1}`}
              title={example.title}
              html={example.html}
            />
          ))}
        </>
      )
    }

    {
      component.notes.length > 0 && (
        <>
          <h2>Accessibility and behavior</h2>
          <ul>
            {component.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </>
      )
    }

    <h2>Files</h2>
    <div class="docs-file-list">
      {
        component.files
          .filter(
            (file) =>
              file.role === "base" || file.path.startsWith("styles/nova/")
          )
          .map((file) => (
            <div>
              <code>{file.path}</code>
              <span class="docs-badge">{file.role}</span>
            </div>
          ))
      }
    </div>

    <h2>Install contract</h2>
    <p>
      The CLI writes the base file under <code>components/</code>, the visual file for the
      selected style under <code>styles/&lt;name&gt;/</code>, and any primitive dependency under
      <code>primitives/</code>. The generated <code>index.css</code> imports them in the right
      layer order.
    </p>

    {
      isExperimental && (
        <p>
          Experimental items install a single Nova style file and are available only while
          the project uses the Nova style. Remove their files and manifest entries before
          switching styles.
        </p>
      )
    }

    <p><a class="docs-header-link" href="/docs/components">← Back to components</a></p>
  </div>
</Layout>

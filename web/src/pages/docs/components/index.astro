---
import Layout from "@/layouts/Layout.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import {
  componentGroups,
  experimentalComponents,
  stableComponents,
  stableComponentsInGroup
} from "@/data/components";
---

<Layout title="Components" description="Browse the loseta component registry.">
  <div class="docs-content">
    <p class="docs-eyebrow">Registry</p>
    <h1>Components</h1>
    <p class="docs-lead">
      {stableComponents.length} stable components and {experimentalComponents.length} experimental
      components. Each page includes markup, the public style contract and the files the CLI
      installs.
    </p>
    <InstallCommand command="loseta add all" />

    {
      componentGroups
        .filter((group) => stableComponentsInGroup(group).length > 0)
        .map((group) => {
          const items = stableComponentsInGroup(group);
          return (
            <section>
              <h2>{group}</h2>
              <div class="docs-grid">
                {items.map((component) => (
                  <a class="docs-card" href={`/docs/components/${component.id}`}>
                    <span class="docs-card-title">{component.title}</span>
                    <span class="docs-card-description">{component.description}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        })
    }

    {
      experimentalComponents.length > 0 && (
        <section>
          <h2>Experimental</h2>
          <p>
            Experimental components are outside the v1 compatibility contract and ship
            only the Nova style. Install them by name with <code>--experimental</code>.
          </p>
          <div class="docs-grid">
            {experimentalComponents.map((component) => (
              <a class="docs-card" href={`/docs/components/${component.id}`}>
                <span class="docs-card-title">{component.title}</span>
                <span class="docs-card-description">{component.description}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
